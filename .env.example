# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

CNCNET_RA1_READY_GRACE_SECONDS=20
CNCNET_RA1_KICK_UNREADY_SECONDS=12
CNCNET_RA1_KICK_AFTER_CANCELLED_STARTS=3

CNCNET_RA1_SPECTATOR_SIDE_ID=11
CNCNET_RA1_MAX_SPECTATORS=2
CNCNET_RA1_VOTEKICK_BAN_HOURS=24
CNCNET_RA1_IDLE_MAP_ROTATE_MINUTES=20
CNCNET_RA1_VOTES_NEEDED=2
CNCNET_RA1_REQUIRE_BALANCED_TEAMS=false
CNCNET_RA1_AUTO_3V3=false
CNCNET_RA1_AUTO_3V3_LOBBY_USERS=550
CNCNET_RA1_MAP_HASHES={}
# Add exact custom map titles and their 40-character SHA-1 values here.

